# ==============================================================================
# PRICERADAR ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or real credentials to Git.

# ------------------------------------------------------------------------------
# Runtime & Data Mode
# ------------------------------------------------------------------------------
# Allowed values: DEMO | LIVE | STALE | UNAVAILABLE
PRICERADAR_DATA_MODE=DEMO

# ------------------------------------------------------------------------------
# Web Application (Port 4178 is mandatory and strictly enforced via CLI flags)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:4178
NEXT_PUBLIC_DEFAULT_LOCALE=es-CO
NEXT_PUBLIC_DEFAULT_CURRENCY=COP

# ------------------------------------------------------------------------------
# Database (Neon PostgreSQL - Phase 2+)
# ------------------------------------------------------------------------------
# Pooled connection string for serverless Next.js queries (read/app)
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/priceradar?sslmode=require
# Direct connection string for migrations and privileged worker execution
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/priceradar?sslmode=require

# ------------------------------------------------------------------------------
# Authentication (Neon Auth / Managed Better Auth - Phase 2+)
# ------------------------------------------------------------------------------
NEON_AUTH_URL=https://auth.example.neon.tech
BETTER_AUTH_SECRET=replace-with-32-byte-cryptographic-random-secret
BETTER_AUTH_URL=http://localhost:4178

# ------------------------------------------------------------------------------
# Discovery Worker Configuration
# ------------------------------------------------------------------------------
WORKER_MAX_PRODUCTS_PER_SCAN=150
WORKER_EXECUTION_TIMEOUT_MS=240000
WORKER_CONCURRENCY=2
WORKER_PROVIDER_ID=fixture-colombia

# ------------------------------------------------------------------------------
# Phase P1 — Privacy-Preserving Fulfillment Context HMAC Secret (F-P1-01)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
# Must be at least 32 bytes of high-entropy key material; placeholder values are rejected.
PRICERADAR_CONTEXT_HMAC_SECRET=replace-with-32-byte-cryptographic-random-context-hmac-secret
# Optional previous secret during a key rotation window to migrate historical observations:
# PRICERADAR_PREVIOUS_CONTEXT_HMAC_SECRET=
